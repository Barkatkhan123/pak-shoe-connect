# ─────────────────────────────────────────────────────────────
# SherSha B2B Footwear Marketplace — Production Environment Variables
# Target Environment: Hostinger Business Web Hosting + External Managed Services
# Domain: https://anamonofficial.com
# Note: DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT
# ─────────────────────────────────────────────────────────────

# ── 1. Production Domain & Application URLs ──────────────────
SITE_URL="https://anamonofficial.com"
VITE_SITE_URL="https://anamonofficial.com"
VITE_SITE_DOMAIN="anamonofficial.com"
VITE_API_URL="https://anamonofficial.com"

# ── 2. External Managed PostgreSQL Database (Supabase / Neon / AWS RDS) ──
# Direct Pooled Connection for Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbooster=true&schema=public"
# Direct Non-Pooled Connection for Prisma Migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres?schema=public"

# ── 3. Supabase Identity & Auth Services ─────────────────────
SUPABASE_PROJECT_ID="ydkdicudwhxrukppucxy"
SUPABASE_URL="https://ydkdicudwhxrukppucxy.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PRODUCTION_SUPABASE_PUBLISHABLE_KEY"
VITE_SUPABASE_PROJECT_ID="ydkdicudwhxrukppucxy"
VITE_SUPABASE_URL="https://ydkdicudwhxrukppucxy.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PRODUCTION_SUPABASE_PUBLISHABLE_KEY"

# ── 4. Optional External Search (Meilisearch Cloud) ──────────
# If omitted or unconfigured, SherSha automatically uses PostgreSQL search fallback
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# ── 5. Optional External Redis (Upstash / Redis Cloud) ───────
# If omitted, queue notifications fall back safely
REDIS_URL=""

# ── 6. Master Admin Authorization & Security ─────────────────
MASTER_ADMIN_EMAIL="anamoontotrade@gmail.com"
NODE_ENV="production"
